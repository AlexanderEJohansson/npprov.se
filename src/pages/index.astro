---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import StructuredData from '../components/StructuredData.astro';
import DataStatus from '../components/DataStatus.astro';
import FragaCountBadge from '../components/FragaCountBadge.astro';
import { formatProvTitel } from '../lib/format-titel';
import { getFragaCountsByProvId, getFragaCount, sortByFragaCount } from '../lib/fraga-counts';

// Hämta live data från Supabase (vid build)
const supabase = createSupabaseServerClient();
let provData: any[] = [];
let fragaCounts: Record<string, number> = {};
if (supabase) {
  try {
    const [{ data }, counts] = await Promise.all([
      supabase.from('prov').select('*').order('ar', { ascending: false }).limit(200),
      getFragaCountsByProvId(supabase),
    ]);
    provData = data || [];
    fragaCounts = counts;
  } catch (_) {
    provData = [];
  }
}

// Räkna statistik (resilient vid build utan DB-nycklar)
const total = provData.length || 109;
const medFraga = sortByFragaCount(
  provData.filter((p: any) => getFragaCount(p, fragaCounts) > 0),
  fragaCounts
);
const totalFragor = Object.values(fragaCounts).reduce((sum, n) => sum + n, 0);
const amnen = [...new Set(provData.map((p: any) => p.amne).filter(Boolean))];
const arRange = provData.length > 0
  ? provData.map((p: any) => p.ar).filter(Boolean).sort((a: number, b: number) => a - b)
  : [2016, 2025];
const minAr = arRange[0] || 2016;
const maxAr = arRange[arRange.length - 1] || 2025;

// Visa de senaste 8 som "Senaste tillagda"
const senaste = [...provData].slice(0, 8);
---

<Layout>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-12">
    <div class="max-w-3xl">
      <div class="inline-block px-4 py-1 bg-teal-100 text-teal-800 rounded-3xl text-sm font-medium mb-4">
        Offentligt material • Stark provenance • Maskinläsbart
      </div>
      
      <h1 class="text-6xl font-semibold tracking-[-1.5px] leading-none text-balance">
        Arkiv för gamla nationella prov.
      </h1>
      
      <p class="mt-6 text-2xl text-slate-600 leading-tight">
        Strukturerat med provenance och kopplingar till Lgr22/Gy25.<br>
        För lärare som vill veta exakt vad som testas.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        {medFraga.length > 0 ? (
          <a href="#med-fraga"
             class="inline-flex items-center justify-center bg-teal-800 hover:bg-teal-900 text-white font-semibold h-12 px-8 rounded-3xl text-lg transition">
            Öva med {totalFragor} frågor
          </a>
        ) : (
          <a href="/prov"
             class="inline-flex items-center justify-center bg-teal-800 hover:bg-teal-900 text-white font-semibold h-12 px-8 rounded-3xl text-lg transition">
            Bläddra bland {total} poster
          </a>
        )}
        <a href="/prov"
           class="inline-flex items-center justify-center border border-slate-300 hover:bg-white font-medium h-12 px-8 rounded-3xl text-lg transition">
          Alla {total} poster
        </a>
        <a href="/genome"
           class="inline-flex items-center justify-center border border-slate-300 hover:bg-white font-medium h-12 px-8 rounded-3xl text-lg transition">
          Question Genome
        </a>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Material från Skolverket, Umeå universitet, Uppsala universitet, Stockholms universitet (PRIM-gruppen), Göteborgs universitet m.fl. • 2016–2025 • Allt offentligt och verifierbart
      </p>
      <div class="mt-2">
        <DataStatus variant="home" />
      </div>
    </div>
  </section>

<StructuredData type="WebSite" />
<StructuredData type="CollectionPage" data={{ name: "Alla prov", url: "https://npprov.se/prov", count: total, description: "Översikt över offentliga nationella prov med full provenance." }} />

  <!-- Snabbstatistik -->
  <section class="max-w-7xl mx-auto px-6 pb-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{total}</div>
        <div class="text-slate-600 mt-1">poster i arkivet</div>
      </div>
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{amnen.length}</div>
        <div class="text-slate-600 mt-1">olika ämnen</div>
      </div>
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{minAr}–{maxAr}</div>
        <div class="text-slate-600 mt-1">årsspann</div>
      </div>
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{medFraga.length || '—'}</div>
        <div class="text-slate-600 mt-1">prov med frågor &amp; facit</div>
      </div>
    </div>
  </section>

  {medFraga.length > 0 && (
    <section id="med-fraga" class="max-w-7xl mx-auto px-6 pb-16">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="text-2xl font-semibold tracking-tight">Öva med strukturerade frågor</h2>
        <a href="/prov#med-fraga" class="text-sm text-teal-700 hover:underline">Se alla i katalogen →</a>
      </div>
      <p class="text-slate-600 mb-5 max-w-2xl">
        Dessa {medFraga.length} prov har riktig frågetext, svarsalternativ och facit – redo att gå igenom direkt utan att ladda ner PDF.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {medFraga.map((item: any) => {
          const fragaCount = getFragaCount(item, fragaCounts);
          return (
            <a href={`/prov/${item.slug || item.id}`} class="card group block bg-white border-2 border-emerald-200 rounded-3xl p-5 hover:border-emerald-400">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="badge bg-teal-100 text-teal-800">{item.amne || 'Okänt'}</span>
                <span class="text-slate-400">•</span>
                <span class="text-slate-500">{item.ar || ''} {item.termin || ''}</span>
              </div>
              <div class="mt-3 font-semibold leading-snug line-clamp-3 group-hover:text-teal-800">
                {formatProvTitel(item)}
              </div>
              <div class="mt-3">
                <FragaCountBadge count={fragaCount} size="md" />
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Senaste material -->
  <section class="max-w-7xl mx-auto px-6 pb-16">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-2xl font-semibold tracking-tight">Senaste tillagda</h2>
      <a href="/prov" class="text-sm text-teal-700 hover:underline">Se hela katalogen →</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {senaste.map((item: any) => (
        <a href={`/prov/${item.slug || item.id}`} class="card group block bg-white border border-slate-200 rounded-3xl p-5 hover:border-teal-200">
          <div class="flex items-center gap-2 text-xs">
            <span class="badge bg-teal-100 text-teal-800">{item.amne || 'Okänt'}</span>
            <span class="text-slate-400">•</span>
            <span class="text-slate-500">{item.ar || ''} {item.termin || ''}</span>
          </div>
          <div class="mt-3 font-semibold leading-snug line-clamp-3 group-hover:text-teal-800">
            {formatProvTitel(item)}
          </div>
          <div class="mt-4 text-xs text-slate-500 flex items-center gap-1">
            <span class="provenance inline">Källa: {item.kalla || 'Skolverket'}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Positionering & Vision -->
  <section class="bg-white border-y border-slate-200 py-12">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-semibold tracking-tight">Vad är npprov.se?</h2>
      <div class="mt-6 text-lg text-slate-600 max-w-2xl mx-auto">
        Ett arkiv med offentliga nationella prov och bedömningsmaterial från Skolverket och universitet. 
        Varje prov har länk till ursprungskällan. Strukturen gör det möjligt att se exakt vilka kunskapskrav som testas i varje fråga.
      </div>
      <div class="mt-8 grid md:grid-cols-3 gap-6 text-left text-sm">
        <div class="p-5 border border-slate-100 rounded-3xl">
          <div class="font-medium text-teal-900">För lärare</div>
          <p class="mt-2 text-slate-600">Se vilka kunskapskrav som faktiskt testas i ett specifikt prov eller en specifik uppgift. Hitta historiska varianter och bedömningsunderlag.</p>
        </div>
        <div class="p-5 border border-slate-100 rounded-3xl">
          <div class="font-medium text-teal-900">För elever</div>
          <p class="mt-2 text-slate-600">Förstå vanliga missförstånd i en uppgift och varför den är viktig. Se kopplingen till det kunskapskrav du behöver öva på.</p>
        </div>
        <div class="p-5 border border-slate-100 rounded-3xl">
          <div class="font-medium text-teal-900">För den som vill analysera</div>
          <p class="mt-2 text-slate-600">Maskinläsbar data med provenance. Möjlighet att se mönster över tid via kunskapsmålskopplingar och trender.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-10">
    <div class="text-center text-sm text-slate-600 space-y-2">
      <p>
        <strong class="text-slate-800">Ekosystem:</strong> npprov.se är arkivet med provenance och per-fråga-analys.
        <a href="https://npmonstret.se" target="_blank" rel="noopener" class="text-teal-700 hover:underline ml-1">NP-Monstret</a> övar adaptivt på samma kunskapskrav.
        <a href="https://npguide.se" target="_blank" rel="noopener" class="text-teal-700 hover:underline ml-1">NP-guide</a> samlar regler och rutiner för skolpersonal.
      </p>
      <p class="text-xs text-slate-500">
        Länkar till systersajterna visas kontextuellt på prov- och frågesidor — inte upprepat på varje frågekort.
      </p>
    </div>
  </section>
</Layout>
