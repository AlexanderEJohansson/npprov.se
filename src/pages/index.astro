---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import StructuredData from '../components/StructuredData.astro';
import DataStatus from '../components/DataStatus.astro';
import FragaCountBadge from '../components/FragaCountBadge.astro';
import { formatProvTitel } from '../lib/format-titel';
import { getFragaCountsByProvId, getFragaCount, sortByFragaCount } from '../lib/fraga-counts';
import { NPPROV_FAQ, faqPageSchema } from '../lib/faq-data';

const HOME_FAQ_IDS = ['officiellt', 'metadata', 'ekosystem', 'vuxen', 'undervisning', 'npcoachen'] as const;
const homeFaq = HOME_FAQ_IDS.map((id) => NPPROV_FAQ.find((f) => f.id === id)!).filter(Boolean);

// Hämta live data från Supabase (vid build)
const supabase = createSupabaseServerClient();
let provData: any[] = [];
let fragaCounts: Record<string, number> = {};
if (supabase) {
  try {
    const [{ data }, counts] = await Promise.all([
      supabase.from('prov').select('*').order('ar', { ascending: false }).limit(200),
      getFragaCountsByProvId(supabase),
    ]);
    provData = data || [];
    fragaCounts = counts;
  } catch (_) {
    provData = [];
  }
}

// Räkna statistik (resilient vid build utan DB-nycklar)
const total = provData.length || 109;
const medFraga = sortByFragaCount(
  provData.filter((p: any) => getFragaCount(p, fragaCounts) > 0),
  fragaCounts
);
const totalFragor = Object.values(fragaCounts).reduce((sum, n) => sum + n, 0);
const amnen = [...new Set(provData.map((p: any) => p.amne).filter(Boolean))];
const arRange = provData.length > 0
  ? provData.map((p: any) => p.ar).filter(Boolean).sort((a: number, b: number) => a - b)
  : [2016, 2025];
const minAr = arRange[0] || 2016;
const maxAr = arRange[arRange.length - 1] || 2025;

// Visa de senaste 8 som "Senaste tillagda"
const senaste = [...provData].slice(0, 8);
---

<Layout>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-14 pb-10">
    <div class="max-w-3xl">
      <p class="text-sm font-medium text-teal-800 mb-3">
        Offentligt material · källa på varje post · {minAr}–{maxAr}
      </p>
      
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight text-balance text-slate-900">
        Gamla nationella prov — arkiv med proveniens
      </h1>
      
      <p class="mt-5 text-lg text-slate-600 leading-relaxed max-w-2xl">
        Här ligger offentliga prov och bedömningsmaterial, spårbart till
        Skolverket och lärosäten. Byggd för lärare och skolpersonal som
        behöver källa — inte en träningsapp för elever.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        {medFraga.length > 0 ? (
          <a href="#med-fraga"
             class="inline-flex items-center justify-center bg-teal-800 hover:bg-teal-900 text-white font-semibold h-11 px-6 rounded-2xl transition">
            Se {totalFragor} frågor med facit
          </a>
        ) : (
          <a href="/prov"
             class="inline-flex items-center justify-center bg-teal-800 hover:bg-teal-900 text-white font-semibold h-11 px-6 rounded-2xl transition">
            Bläddra bland {total} poster
          </a>
        )}
        <a href="/prov"
           class="inline-flex items-center justify-center border border-slate-300 hover:bg-white font-medium h-11 px-6 rounded-2xl transition">
          Alla poster
        </a>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Källor: Skolverket, Umeå, Uppsala, PRIM-gruppen m.fl. Allt offentligt.
      </p>
      <div class="mt-2">
        <DataStatus variant="home" />
      </div>
    </div>
  </section>

<StructuredData type="WebSite" />
<StructuredData type="CollectionPage" data={{ name: "Alla prov", url: "https://npprov.se/prov", count: total, description: "Översikt över offentliga nationella prov med full provenance." }} />

  <!-- Snabbstatistik -->
  <section class="max-w-7xl mx-auto px-6 pb-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{total}</div>
        <div class="text-slate-600 mt-1">poster i arkivet</div>
      </div>
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{amnen.length}</div>
        <div class="text-slate-600 mt-1">olika ämnen</div>
      </div>
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{minAr}–{maxAr}</div>
        <div class="text-slate-600 mt-1">årsspann</div>
      </div>
      <div class="bg-white border border-slate-200 rounded-3xl p-6">
        <div class="text-4xl font-semibold tabular-nums text-teal-900">{medFraga.length || '—'}</div>
        <div class="text-slate-600 mt-1">prov med frågor &amp; facit</div>
      </div>
    </div>
  </section>

  {medFraga.length > 0 && (
    <section id="med-fraga" class="max-w-7xl mx-auto px-6 pb-16">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="text-2xl font-semibold tracking-tight">Prov med inlagda frågor</h2>
        <a href="/prov#med-fraga" class="text-sm text-teal-700 hover:underline">Hela listan →</a>
      </div>
      <p class="text-slate-600 mb-5 max-w-2xl">
        {medFraga.length} prov har frågetext och facit i databasen — du slipper öppna PDF:en först.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {medFraga.map((item: any) => {
          const fragaCount = getFragaCount(item, fragaCounts);
          return (
            <a href={`/prov/${item.slug || item.id}`} class="card group block bg-white border-2 border-emerald-200 rounded-3xl p-5 hover:border-emerald-400">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="badge bg-teal-100 text-teal-800">{item.amne || 'Okänt'}</span>
                <span class="text-slate-400">•</span>
                <span class="text-slate-500">{item.ar || ''} {item.termin || ''}</span>
              </div>
              <div class="mt-3 font-semibold leading-snug line-clamp-3 group-hover:text-teal-800">
                {formatProvTitel(item)}
              </div>
              <div class="mt-3">
                <FragaCountBadge count={fragaCount} size="md" />
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Senaste material -->
  <section class="max-w-7xl mx-auto px-6 pb-16">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-2xl font-semibold tracking-tight">Senaste tillagda</h2>
      <a href="/prov" class="text-sm text-teal-700 hover:underline">Se hela katalogen →</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {senaste.map((item: any) => (
        <a href={`/prov/${item.slug || item.id}`} class="card group block bg-white border border-slate-200 rounded-3xl p-5 hover:border-teal-200">
          <div class="flex items-center gap-2 text-xs">
            <span class="badge bg-teal-100 text-teal-800">{item.amne || 'Okänt'}</span>
            <span class="text-slate-400">•</span>
            <span class="text-slate-500">{item.ar || ''} {item.termin || ''}</span>
          </div>
          <div class="mt-3 font-semibold leading-snug line-clamp-3 group-hover:text-teal-800">
            {formatProvTitel(item)}
          </div>
          <div class="mt-4 text-xs text-slate-500 flex items-center gap-1">
            <span class="provenance inline">Källa: {item.kalla || 'Skolverket'}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-white border-y border-slate-200 py-12">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Vad är det här?</h2>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Ett oberoende arkiv med offentliga nationella prov och bedömningsmaterial.
        Varje post har länk till ursprungskällan. Syftet är spårbarhet — inte att
        ersätta Skolverket eller en övningsapp.
      </p>
      <div class="mt-8 grid sm:grid-cols-2 gap-4 text-sm">
        <div class="p-5 border border-slate-100 rounded-2xl bg-slate-50">
          <div class="font-medium text-teal-900">För dig i skolan</div>
          <p class="mt-2 text-slate-600">
            Hitta historiska prov, bedömningsunderlag och se kopplingar till
            kunskapskrav där de är inlagda.
          </p>
        </div>
        <div class="p-5 border border-slate-100 rounded-2xl bg-slate-50">
          <div class="font-medium text-teal-900">Vill du öva istället?</div>
          <p class="mt-2 text-slate-600">
            Gå till{' '}
            <a
              href="https://npmonstret.se/npcoachen?utm_source=npprov&utm_medium=ecosystem&utm_campaign=home"
              target="_blank"
              rel="noopener"
              class="text-teal-800 underline"
            >
              NPcoachen
            </a>
            . Regler för genomförande finns på{' '}
            <a href="https://npguide.se/?utm_source=npprov&utm_medium=ecosystem&utm_campaign=home" target="_blank" rel="noopener" class="text-teal-800 underline">
              npguide.se
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ: delad kanonsvar (src/lib/faq-data.ts) + hub /faq -->
  <section class="max-w-3xl mx-auto px-6 pb-16" aria-labelledby="faq-home">
    <h2 id="faq-home" class="text-2xl font-semibold text-slate-900 mb-6 text-center">
      Vanliga frågor om arkivet
    </h2>
    <div class="space-y-3">
      {homeFaq.map((item) => (
        <details class="group rounded-2xl border border-slate-200 bg-white p-5">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex justify-between gap-4">
            {item.question}
            <span class="text-teal-700 group-open:rotate-180 transition">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
    <p class="mt-6 text-center text-sm text-slate-500">
      <a href="/faq" class="font-medium text-teal-800 underline underline-offset-2">Alla frågor (FAQ-hub)</a>
    </p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema(homeFaq))} />
</Layout>
