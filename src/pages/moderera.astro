---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import { formatProvTitel } from '../lib/format-titel';

const supabase = createSupabaseServerClient();

// Simple protection: require ?secret=XXX matching MODERATOR_SECRET (or leave empty for internal use)
const providedSecret = Astro.url.searchParams.get('secret') || '';
const expectedSecret = import.meta.env.MODERATOR_SECRET;

let unauthorized = false;
if (expectedSecret && providedSecret !== expectedSecret) {
  unauthorized = true;
}

let pending: any[] = [];
let approvedRecent: any[] = [];
let rejectedRecent: any[] = [];

if (!unauthorized && supabase) {
  const { data: pendingData } = await supabase
    .from('community_forklaring')
    .select(`
      id, text, forfattare, forfattare_roll, status, created_at, moderation_note,
      fraga:fraga_id(id, fraga_nummer, text, delprov:delprov_id(beteckning, prov:prov_id(slug, titel, amne, ar, termin, typ)))
    `)
    .in('status', ['pending', 'needs_revision'])
    .order('created_at', { ascending: true })
    .limit(50);

  pending = pendingData || [];

  const { data: approvedData } = await supabase
    .from('community_forklaring')
    .select('id, text, forfattare, status, moderated_at, moderation_note, moderated_by')
    .eq('status', 'approved')
    .order('moderated_at', { ascending: false })
    .limit(10);

  approvedRecent = approvedData || [];

  const { data: rejectedData } = await supabase
    .from('community_forklaring')
    .select('id, text, forfattare, status, moderated_at, moderation_note, moderated_by')
    .eq('status', 'rejected')
    .order('moderated_at', { ascending: false })
    .limit(10);

  rejectedRecent = rejectedData || [];
}
---

<Layout>
  <main class="max-w-4xl mx-auto px-6 py-10">
    <a href="/" class="text-sm text-teal-700">← Tillbaka</a>

    <h1 class="mt-6 text-4xl font-semibold tracking-tight">Moderera bidrag</h1>

    <div class="mt-2 text-sm text-slate-600">
      Internt verktyg. Godkända bidrag blir publika med full provenance.
    </div>

    {unauthorized ? (
      <div class="mt-8 p-6 bg-red-50 border border-red-200 rounded-3xl">
        <p class="text-red-700">Obehörig åtkomst. Lägg till ?secret=DIN_MODERATOR_SECRET i URL:en (sätt MODERATOR_SECRET i env).</p>
      </div>
    ) : (
      <>
        <div class="mt-8">
          <h2 class="font-semibold text-xl mb-4">Kö för granskning ({pending.length})</h2>
          <p class="text-sm text-slate-500 mb-4">Visar status pending och needs_revision.</p>

          <div class="mb-4 p-3 bg-slate-50 border border-dashed rounded-2xl text-sm">
            <button 
              type="button"
              id="add-test-bidrag-btn"
              class="px-3 py-1 bg-teal-700 text-white text-xs rounded hover:bg-teal-800"
            >
              + Lägg till exempelbidrag (för test av moderering)
            </button>
            <span class="ml-2 text-xs text-slate-500">Skapar ett pending bidrag direkt via /api/contribute.</span>
          </div>

          {pending.length === 0 && (
            <p class="text-slate-500">Inga pending bidrag just nu.</p>
          )}

          <div class="space-y-6">
            {pending.map((c: any) => (
              <div class="border border-slate-200 rounded-3xl p-5 bg-white" data-id={c.id}>
                <div class="text-xs text-slate-500 flex flex-wrap items-center gap-2">
                  <span>{new Date(c.created_at).toLocaleString('sv-SE')} • {c.forfattare || 'Anonym'} ({c.forfattare_roll || 'okänd'})</span>
                  {c.status === 'needs_revision' && (
                    <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Behöver revidering</span>
                  )}
                </div>

                <div class="mt-2 text-sm whitespace-pre-wrap">{c.text}</div>

                {c.fraga && (
                  <div class="mt-3 text-xs text-teal-700">
                    Kopplat till: Fråga {c.fraga.fraga_nummer} — {formatProvTitel(c.fraga.delprov?.prov || {})}
                    <a href={`/prov/${c.fraga.delprov?.prov?.slug}/fraga/${c.fraga.id}`} class="underline ml-1">Öppna per-fråga →</a>
                  </div>
                )}

                <form class="moderate-form mt-4 space-y-2" data-id={c.id}>
                  <div class="flex gap-2 items-center text-sm">
                    <select name="status" class="border border-slate-300 rounded px-2 py-1 text-sm">
                      <option value="approved">Godkänn (approved)</option>
                      <option value="rejected">Avslå (rejected)</option>
                      <option value="needs_revision">Behöver revidering</option>
                    </select>

                    <input type="text" name="moderated_by" placeholder="Ditt namn / roll" class="border border-slate-300 rounded px-2 py-1 text-sm flex-1" value="Moderator" />

                    <button type="submit" class="px-4 py-1 bg-teal-800 text-white rounded text-sm">Uppdatera</button>
                  </div>

                  <textarea name="moderation_note" placeholder="Moderationsanteckning (valfritt men rekommenderat)" class="w-full border border-slate-300 rounded p-2 text-sm" rows="2"></textarea>
                </form>

                <div class="moderate-result mt-1 text-sm hidden"></div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-10 grid md:grid-cols-2 gap-8">
          <div>
            <h2 class="font-semibold text-xl mb-4">Senast godkända</h2>
            {approvedRecent.length === 0 && <p class="text-slate-500 text-sm">Inga godkända än.</p>}
            <ul class="text-sm space-y-2">
              {approvedRecent.map((c: any) => (
                <li class="border-l-2 border-emerald-400 pl-3">
                  {c.text.slice(0, 140)}…
                  <span class="text-xs text-slate-500"> ({c.moderated_at ? new Date(c.moderated_at).toLocaleDateString('sv-SE') : ''})</span>
                  {c.moderation_note && <div class="text-[10px] text-slate-500">Not: {c.moderation_note}</div>}
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="font-semibold text-xl mb-4">Senast avslagna</h2>
            {rejectedRecent.length === 0 && <p class="text-slate-500 text-sm">Inga avslagna än.</p>}
            <ul class="text-sm space-y-2">
              {rejectedRecent.map((c: any) => (
                <li class="border-l-2 border-red-300 pl-3">
                  {c.text.slice(0, 140)}…
                  <span class="text-xs text-slate-500"> ({c.moderated_at ? new Date(c.moderated_at).toLocaleDateString('sv-SE') : ''})</span>
                  {c.moderation_note && <div class="text-[10px] text-slate-500">Not: {c.moderation_note}</div>}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-8 text-xs text-slate-500 border-l-2 border-slate-200 pl-3">
          <strong>Ärlig status:</strong> Detta är ett internt modereringsverktyg. 
          När ett bidrag godkänns (status=approved) blir det publikt via RLS och syns i per-fråga, genome och kan användas för att uppdatera trender.
          Inga automatiska uppdateringar av fraga-fält sker ännu vid godkännande.
        </div>
      </>
    )}
  </main>

  <script>
    // Extract secret from URL for API calls (page already requires it to load)
    const secret = new URLSearchParams(window.location.search).get('secret') || '';

    // Quick test bidrag button (for populating the moderation queue)
    const testBtn = document.getElementById('add-test-bidrag-btn');
    if (testBtn) {
      testBtn.addEventListener('click', async () => {
        testBtn.textContent = 'Lägger till...';
        try {
          const res = await fetch('/api/contribute', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
              fragaRef: 'test-fraga-1',
              typ: 'Förklaring / missförstånd',
              text: 'Elever tolkar "argumentera" som bara "tycka" utan att använda källor eller motivera.',
              roll: 'Test via modereringssidan'
            })
          });
          const j = await res.json().catch(() => ({}));
          if (j.success) {
            alert('Testbidrag tillagt! Ladda om sidan för att se det i listan.');
            location.reload();
          } else {
            alert('Kunde inte lägga till: ' + (j.error || 'okänt fel'));
          }
        } catch (e) {
          alert('Nätverksfel vid tillägg av testbidrag.');
        }
        testBtn.textContent = '+ Lägg till exempelbidrag (för test av moderering)';
      });
    }

    // Client-side moderation (posts to /api/moderate)
    document.querySelectorAll('.moderate-form').forEach((form: HTMLFormElement) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const container = form.closest('[data-id]');
        const resultEl = container?.querySelector('.moderate-result') as HTMLElement;
        if (!resultEl) return;

        resultEl.textContent = 'Uppdaterar...';
        resultEl.className = 'moderate-result mt-1 text-sm text-slate-600';

        const id = container?.getAttribute('data-id');
        const fd = new FormData(form);

        const payload = {
          id,
          status: fd.get('status'),
          moderation_note: fd.get('moderation_note'),
          moderated_by: fd.get('moderated_by'),
        };

        try {
          const res = await fetch('/api/moderate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-moderator-secret': secret },
            body: JSON.stringify(payload),
          });
          const json = await res.json();

          if (json.success) {
            const label = json.status === 'rejected' ? 'Avslaget' : json.status === 'needs_revision' ? 'Markerat för revidering' : 'Godkänt';
            resultEl.textContent = `${label}! Uppdaterar listan…`;
            resultEl.className = json.status === 'rejected'
              ? 'moderate-result mt-1 text-sm text-red-700'
              : 'moderate-result mt-1 text-sm text-emerald-700';
            form.style.opacity = '0.4';
            form.style.pointerEvents = 'none';
            setTimeout(() => location.reload(), 900);
          } else {
            resultEl.textContent = 'Fel: ' + (json.error || 'Kunde inte uppdatera');
            resultEl.className = 'moderate-result mt-1 text-sm text-red-700';
          }
        } catch (err) {
          resultEl.textContent = 'Nätverksfel.';
          resultEl.className = 'moderate-result mt-1 text-sm text-red-700';
        }
      });
    });
  </script>
</Layout>
