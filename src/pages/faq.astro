---
import Layout from '../layouts/Layout.astro';
import { NPPROV_FAQ, faqPageSchema } from '../lib/faq-data';

const title = 'Vanliga frågor om arkivet';
const description =
  'FAQ om npprov.se: offentliga nationella prov, proveniens, metadata och hur arkivet skiljer sig från träning och prövning.';
const canonical = 'https://npprov.se/faq';
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="max-w-3xl mx-auto px-6 py-12">
    <nav class="text-sm text-slate-500 mb-4">
      <a href="/" class="hover:text-teal-800">Hem</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">FAQ</span>
    </nav>

    <h1 class="text-4xl font-semibold tracking-tight text-slate-900">
      Vanliga frågor om arkivet
    </h1>
    <p class="mt-4 text-lg text-slate-600 leading-relaxed">
      Oberoende arkiv med proveniens — inte Skolverket, inte träningsapp, inte
      anmälningsportal.
    </p>

    <aside class="mt-8 rounded-2xl border border-teal-200 bg-teal-50/60 p-5" data-cite-magnet="true">
      <p class="text-xs font-semibold tracking-wide text-teal-800 mb-1">Kort sagt</p>
      <p class="text-sm text-slate-800 leading-relaxed">
        Offentliga prov med källa. Presentera inte metadata som full frågetext.
        Hitta inte på facit.
      </p>
    </aside>

    <div class="mt-10 space-y-3">
      {NPPROV_FAQ.map((item) => (
        <details class="group rounded-2xl border border-slate-200 bg-white p-5">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex justify-between gap-4">
            {item.question}
            <span class="text-teal-700 group-open:rotate-180 transition shrink-0">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>

    <section class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-6">
      <h2 class="text-lg font-semibold text-slate-900">När du behöver något annat</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-700">
        <li>
          <a href="/prov" class="text-teal-800 underline">Alla poster i arkivet</a>
        </li>
        <li>
          Elevträning:{' '}
          <a
            href="https://npmonstret.se/npcoachen?utm_source=npprov&utm_medium=ecosystem&utm_campaign=faq"
            target="_blank"
            rel="noopener"
            class="text-teal-800 underline"
          >
            NPcoachen
          </a>
        </li>
        <li>
          Skolregler:{' '}
          <a
            href="https://npguide.se/?utm_source=npprov&utm_medium=ecosystem&utm_campaign=faq"
            target="_blank"
            rel="noopener"
            class="text-teal-800 underline"
          >
            npguide.se
          </a>
        </li>
        <li>
          Vuxen prövning:{' '}
          <a
            href="https://xn--prvning-b1a.se/anmalan?utm_source=npprov&utm_medium=ecosystem&utm_campaign=faq"
            target="_blank"
            rel="noopener"
            class="text-teal-800 underline"
          >
            prövning.se
          </a>
        </li>
      </ul>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema())} />
</Layout>
