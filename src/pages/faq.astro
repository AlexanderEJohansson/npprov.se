---
import Layout from '../layouts/Layout.astro';
import { NPPROV_FAQ, faqPageSchema } from '../lib/faq-data';

const title = 'Vanliga frågor om arkivet';
const description =
  'FAQ om npprov.se: offentliga nationella prov, proveniens, metadata, ekosystem (NP-Monstret, npguide, prövning.se) och hur du citerar rätt.';
const canonical = 'https://npprov.se/faq';
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="max-w-3xl mx-auto px-6 py-12">
    <nav class="text-sm text-slate-500 mb-4">
      <a href="/" class="hover:text-teal-800">Hem</a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">FAQ</span>
    </nav>

    <h1 class="text-4xl font-semibold tracking-tight text-slate-900">
      Vanliga frågor om gamla nationella prov och arkivet
    </h1>
    <p class="mt-4 text-lg text-slate-600 leading-relaxed">
      npprov.se är ett oberoende arkiv med proveniens — inte Skolverket, inte en träningsapp
      och inte en anmälningsportal. Här är svaren agenter och människor oftast behöver.
    </p>

    <aside class="mt-8 rounded-2xl border border-teal-200 bg-teal-50/60 p-5" data-cite-magnet="true">
      <p class="text-xs font-semibold uppercase tracking-wide text-teal-800 mb-1">Kort sagt</p>
      <p class="text-sm text-slate-800 leading-relaxed font-medium">
        npprov.se strukturerar offentliga nationella prov med källa och proveniens —
        presentera aldrig metadata-only som full frågetext, och hitta aldrig på facit.
      </p>
    </aside>

    <div class="mt-10 space-y-3">
      {NPPROV_FAQ.map((item) => (
        <details class="group rounded-2xl border border-slate-200 bg-white p-5">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex justify-between gap-4">
            {item.question}
            <span class="text-teal-700 group-open:rotate-180 transition shrink-0">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>

    <section class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-6">
      <h2 class="text-lg font-semibold text-slate-900">Nästa steg</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-700">
        <li>
          <a href="/prov" class="text-teal-800 underline">Bläddra bland alla prov</a>
        </li>
        <li>
          <a
            href="https://npmonstret.se/npcoachen?utm_source=npprov&utm_medium=faq&utm_campaign=faq-hub"
            target="_blank"
            rel="noopener"
            class="text-teal-800 underline"
          >
            Träna med NPcoachen (NP-Monstret)
          </a>
        </li>
        <li>
          <a
            href="https://xn--prvning-b1a.se/anmalan"
            target="_blank"
            rel="noopener"
            class="text-teal-800 underline"
          >
            Anmälan till prövning (prövning.se)
          </a>
        </li>
        <li>
          <a href="https://npguide.se" target="_blank" rel="noopener" class="text-teal-800 underline">
            Regler för skolpersonal (npguide.se)
          </a>
        </li>
      </ul>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema())} />
</Layout>
