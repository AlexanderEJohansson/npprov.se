---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Offentliga nationella prov med källa och proveniens. Strukturerat arkiv för lärare och skolpersonal — inte Skolverket, inte en träningsapp.',
  canonical = 'https://npprov.se/',
} = Astro.props;

const pageTitle = title
  ? `${title} | npprov.se`
  : 'npprov.se – Gamla nationella prov med proveniens';
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social trust -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="npprov.se" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://npprov.se/og-default.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="npprov.se — gamla nationella prov, arkiv med proveniens" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://npprov.se/og-default.svg" />
    
    <!-- Agentic SEO / AEO 2026 -->
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Instructions for AI agents (llms.txt)" />

    <!-- Organization + WebSite: ekosystem sameAs (GEO / knowledge graph) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://npprov.se/#organization",
          "name": "npprov.se",
          "url": "https://npprov.se",
          "description": "Oberoende arkiv för offentliga nationella prov med proveniens. Inte Skolverket, inte träningsapp.",
          "parentOrganization": {
            "@type": "Organization",
            "name": "Lärinsikt AB",
            "url": "https://larinsikt.se",
          },
          "sameAs": [
            "https://larinsikt.se",
            "https://npmonstret.se",
            "https://npmonstret.se/npcoachen",
            "https://npmonstret.se/for-agents",
            "https://npguide.se",
            "https://xn--prvning-b1a.se",
          ],
        },
        {
          "@type": "WebSite",
          "@id": "https://npprov.se/#website",
          "name": "npprov.se",
          "url": "https://npprov.se",
          "inLanguage": "sv-SE",
          "publisher": { "@id": "https://npprov.se/#organization" },
          "description": "Arkiv för offentliga nationella prov med källa och proveniens.",
        },
      ],
    })} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <!-- Top bar / Navigation (professionell) -->
    <header class="border-b border-slate-200 bg-white sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-x-3">
            <!-- Simple, sharp logo for npprov -->
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0" role="img" aria-label="npprov.se">
              <title>npprov.se</title>
              <rect width="32" height="32" rx="8" fill="#134E4A"/>
              <text 
                x="16" 
                y="21" 
                text-anchor="middle" 
                fill="white" 
                font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" 
                font-size="17" 
                font-weight="700" 
                letter-spacing="-0.5">NP</text>
            </svg>
            <div>
              <div class="font-semibold text-2xl tracking-[-0.5px] text-teal-900">npprov.se</div>
              <div class="text-[10px] text-teal-700 -mt-1.5 font-medium">gamla nationella prov</div>
            </div>
          </a>

          <nav class="flex items-center gap-x-8 text-sm font-medium" aria-label="Huvudnavigation">
            <a href="/prov" class="text-slate-600 hover:text-teal-900 transition">Alla prov</a>
            <a href="/kallor" class="text-slate-600 hover:text-teal-900 transition">Källor</a>
            <a href="/genome" class="text-slate-600 hover:text-teal-900 transition">Question Genome</a>
            <a href="/trender" class="text-slate-600 hover:text-teal-900 transition">Trender &amp; Prediktion</a>
            <a href="/faq" class="text-slate-600 hover:text-teal-900 transition">FAQ</a>
            <a href="/bidra" class="text-slate-600 hover:text-teal-900 transition">Bidra</a>
            <a href="https://npmonstret.se/npcoachen?utm_source=npprov&utm_medium=nav&utm_campaign=header" target="_blank" rel="noopener" 
               class="text-slate-500 hover:text-teal-700 transition text-xs px-3 py-1 border border-slate-200 rounded-2xl hover:border-teal-200"
               title="Separat träningsprodukt — npprov.se är arkivet">
              Vill du träna? NPcoachen →
            </a>
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer class="border-t border-slate-200 bg-white mt-16 py-10 text-sm text-slate-500">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between gap-y-4">
          <div>
            <p>
              Oberoende arkiv med offentliga nationella prov. Allt material är
              offentligt och länkas till ursprungskällan.
            </p>
            <p class="mt-2 text-xs text-slate-400">
              Inte Skolverket. Inte en träningsapp.
            </p>
          </div>
          <div class="text-xs space-y-2">
            <p class="text-slate-500">
              <a href="/om" class="hover:text-teal-700">Om</a>
              {' · '}
              <a href="/faq" class="hover:text-teal-700">FAQ</a>
              {' · '}
              <a href="/kallor" class="hover:text-teal-700">Källor</a>
              {' · '}
              <a href="/llms.txt" class="hover:text-teal-700">llms.txt</a>
            </p>
            <p class="text-slate-500">
              <span class="text-slate-400">Syskon:</span>
              {' '}
              <a href="https://npguide.se?utm_source=npprov&utm_medium=ecosystem&utm_campaign=footer" target="_blank" rel="noopener" class="hover:text-teal-700">npguide (regler)</a>
              {' · '}
              <a href="https://npmonstret.se/npcoachen?utm_source=npprov&utm_medium=ecosystem&utm_campaign=footer" target="_blank" rel="noopener" class="hover:text-teal-700">NPcoachen (enda betald träning)</a>
              {' · '}
              <a href="https://xn--prvning-b1a.se/?utm_source=npprov&utm_medium=ecosystem&utm_campaign=footer" target="_blank" rel="noopener" class="hover:text-teal-700">prövning.se</a>
            </p>
            <p class="text-slate-400">
              Bolag:
              {' '}
              <a href="https://larinsikt.se/?utm_source=npprov&utm_medium=ecosystem&utm_campaign=footer" target="_blank" rel="noopener" class="hover:text-teal-700">Lärinsikt AB</a>
              {' · '}
              augusti 2026
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
